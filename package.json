{
  "name": "nexotasks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --project demo-nexotasks --only firestore \"vitest run tests/firestore.rules.test.ts\"",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test:ui": "vitest run src",
    "test:unit": "vitest run --exclude tests/firestore.rules.test.ts",
    "test:watch": "vitest --exclude tests/firestore.rules.test.ts",
    "test:all": "npm run test:unit && npm run test:rules"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1165.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "overrides": {
    "jwks-rsa": "^3.2.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "firebase-tools": "^15.35.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vercel": "^65.12.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
